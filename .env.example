# Copy this file to .env and fill in your key.
# The key stays on the server and is NEVER sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=3000
# Model used for explanations. Opus is the most accurate; explanations are cached
# per card so cost stays low. Switch to claude-sonnet-4-6 if you want it cheaper.
EXPLAINER_MODEL=claude-opus-4-8
